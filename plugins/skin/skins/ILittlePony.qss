	border-style: solid;
	border-width: 2px;
	color: #FFFFFF;
}
QComboBox::drop-down {
	background-color: transparent;
	border-bottom-right-radius: 7px;
	border-color: #FFFFFF;
	border-style: outset;
	border-top-right-radius: 7px;
	border-width: 1px;
	min-height: 10px;
	width: 10px;
}
QComboBox::drop-down:hover {
	background-color: qradialgradient(cx: 0.5, cy: 0.5, fx: 0.5, fy: 0.5, radius: 1.0, stop:0.10 #3F96FF, stop:0.26 #7791FF, stop:0.39 #938DFF, stop:0.42 #A06DFF, stop:0.58 #CD69FF, stop:0.71 #DC66FF, stop:0.84 #F564FF, stop:1 #DBD9F1);
	border-style: inset;
	border-width: 1px;
