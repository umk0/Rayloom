QStatusBar {
	color: #FF00BF;
}
QSpinBox, QDoubleSpinBox {
	background-color: #0033CC;
	border-bottom-color: #7791FF;
	border-left-color: #938DFF;
	border-radius: 10px;
	border-right-color: #938DFF;
	border-style: solid;
	border-top-color: #7791FF;
	border-width: 2px;
	color: #FFFFFF;
	font-size: 13px;
	padding: 2px;
	selection-background-color: #FF00BF;
	selection-color: #FFFFFF;
}
QSpinBox:hover, QDoubleSpinBox:hover {
	background-color: qradialgradient(cx: 0.5, cy: 0.5, fx: 0.5, fy: 0.5, radius: 1.0, stop:0.10 #3F96FF, stop:0.26 #7791FF, stop:0.39 #938DFF, stop:0.42 #A06DFF, stop:0.58 #CD69FF, stop:0.71 #DC66FF, stop:0.84 #F564FF, stop:1 #DBD9F1);
	border-bottom-color: #DC66FF;
	border-left-color: #CD69FF;
	border-right-color: #CD69FF;
	border-top-color: #DC66FF;
}
QDoubleSpinBox::up-button, QSpinBox::up-button {
	background-color: transparent;
	border-bottom: none;
	border-color: #938DFF;
	border-style: outset;
	border-top-right-radius: 6px;
	border-width: 1px;
	height: 10px;
	width: 10px;
}
QDoubleSpinBox::down-button, QSpinBox::down-button {
	background-color: transparent;
	border-color: #938DFF;
	border-style: outset;
	border-top: none;
	border-bottom-right-radius: 6px;
	border-width: 1px;
	height: 10px;
	width: 10px;
}
QDoubleSpinBox::up-button:pressed,  QSpinBox::up-button:pressed {
	background-color: qlineargradient(spread:pad, x1:0, y1:1, x2:0, y2:0, stop:0.01 #B8CDF2, stop:0.18 #3F96FF, stop:0.39 #7791FF, stop:0.50 #938DFF, stop:0.63 #A06DFF, stop:0.75 #CD69FF, stop:0.88 #DC66FF, stop:0.97 #F564FF, stop:1 #DBD9F1);
}
QDoubleSpinBox::down-button:pressed, QSpinBox::down-button:pressed {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0.01 #B8CDF2, stop:0.18 #3F96FF, stop:0.39 #7791FF, stop:0.50 #938DFF, stop:0.63 #A06DFF, stop:0.75 #CD69FF, stop:0.88 #DC66FF, stop:0.97 #F564FF, stop:1 #DBD9F1);
}
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover, QSpinBox::up-button:hover, QSpinBox::down-button:hover {
	border-style: inset;
	border-width: 1px;
	padding-top: -1px;
}
QTimeEdit, QDateTimeEdit, QDateEdit, QToolBox, QToolBox::tab, QToolBox::tab:selected, QScrollArea {
	background-color: #0033CC;
	color: #FFFFFF;	
}
QComboBox {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0.01 #B8CDF2, stop:0.18 #3F96FF, stop:0.39 #7791FF, stop:0.50 #938DFF, stop:0.63 #A06DFF, stop:0.75 #CD69FF, stop:0.88 #DC66FF, stop:0.97 #F564FF, stop:1 #DBD9F1);
	border-color: #FFFFFF;
	border-radius: 10px;
	border-style: solid;
	border-width: 2px;
	font-size: 11px;
	height: 20px;
	padding-bottom: 3px;
	padding-left: 4px;
	padding-right: 2px;
	padding-top: 3px;
	selection-color: #FFFFFF;
	selection-background-color: #FF00BF;
}
