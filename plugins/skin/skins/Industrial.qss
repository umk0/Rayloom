QLineEdit {
	background-color: #271F24;
	border-radius: 5px;
	border-style: solid;
	border-width: 2px;
	color: #FFFFFF;
	font-size: 11px;
	min-height: 18px;
	padding-bottom: 2px;
	padding-left: 2px;
	selection-background-color: #FFFFFF;
	selection-color: #271F24;
}
QLineEdit:hover {
	background-color: qradialgradient(spread:pad, cx: 0.5, cy: 0.5, fx: 0.5, fy: 0.5, radius: 1.0, stop:0.10 #66FF66, stop:0.20 #00E600, stop:1 #271F24);
	border-color: #00FF00;
	color: #000000;
}
QLCDNumber {
	color: #FF00BF;
}
QProgressBar {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0.25 #737375, stop:1 #414143);
	border-color: #FFFFFF;
	border-radius: 5px;
	border-style: solid;
	border-width: 2px;
	color: #000000;
	font-size: 11px;
	height: 26px;
	text-align: center;
}
QProgressBar::chunk {
	background-color: qlineargradient(x1:1, y1:0.02, x2:0, y2:0, stop:0 #FFFFFF, stop:0.09 #FFFFFF, stop:0.10 #EE2028, stop:0.19 #EE2028, stop:0.20 #FFFFFF, stop:0.29 #FFFFFF, stop:0.30 #EE2028, stop:0.39 #EE2028, stop:0.40 #FFFFFF, stop:0.49 #FFFFFF, stop:0.50 #EE2028, stop:0.59 #EE2028, stop:0.60 #FFFFFF, stop:0.69 #FFFFFF, stop:0.70 #EE2028, stop:0.79 #EE2028, stop:0.80 #FFFFFF, stop:0.89 #FFFFFF, stop:0.90 #EE2028, stop:0.95 #EE2028, stop:1 #FFFFFF);
	border: none;
}
QMenuBar {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0.25 #737375, stop:1 #414143);
}
QMenuBar::item {
  	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0.25 #737375, stop:1 #414143);
	color: #FFFFFF;
  	padding: 1px 4px;
  	spacing: 3px;
}
QMenuBar::item:selected {
  	background-color: #FF00BF;
	color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0.25 #737375, stop:1 #414143);
}
QMenu {
	background-color: transparent;
	font-size: 11px;
	padding: 0px;
}
QMenu::item {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0.25 #737375, stop:1 #414143);
	border-color: transparent;
	border-radius: 5px;
	border-style: solid;
	border-width: 2px;
	color: #FFFFFF;
	font-size: 11px;
	min-width: 80px;
	padding-bottom: 2px;
	padding-left: 10px;
	padding-right: 10px;
	padding-top: 2px;
}
QMenu::item:selected {
	background-color: #027BC1;
	border-color: qlineargradient(x1:1, y1:0.02, x2:0, y2:0, stop:0 #271F24, stop:0.09 #271F24, stop:0.10 #FFE01B, stop:0.19 #FFE01B, stop:0.20 #271F24, stop:0.29 #271F24, stop:0.30 #FFE01B, stop:0.39 #FFE01B, stop:0.40 #271F24, stop:0.49 #271F24, stop:0.50 #FFE01B, stop:0.59 #FFE01B, stop:0.60 #271F24, stop:0.69 #271F24, stop:0.70 #FFE01B, stop:0.79 #FFE01B, stop:0.80 #271F24, stop:0.89 #271F24, stop:0.90 #FFE01B, stop:0.95 #FFE01B, stop:1 #271F24);
}
QMenu::item:pressed {
	background-color: qlineargradient(x1:1, y1:0.02, x2:0, y2:0, stop:0 #FFFFFF, stop:0.09 #FFFFFF, stop:0.10 #EE2028, stop:0.19 #EE2028, stop:0.20 #FFFFFF, stop:0.29 #FFFFFF, stop:0.30 #EE2028, stop:0.39 #EE2028, stop:0.40 #FFFFFF, stop:0.49 #FFFFFF, stop:0.50 #EE2028, stop:0.59 #EE2028, stop:0.60 #FFFFFF, stop:0.69 #FFFFFF, stop:0.70 #EE2028, stop:0.79 #EE2028, stop:0.80 #FFFFFF, stop:0.89 #FFFFFF, stop:0.90 #EE2028, stop:0.95 #EE2028, stop:1 #FFFFFF);
	border-color: #E32528;
	color: #000000;
}
QTabWidget {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0.25 #737375, stop:1 #414143);
}
QTabWidget::pane {
	background: none;
	border: none;
	padding-top: -2px;
}
QTabWidget::tab-bar:top {
    alignment: center;
}
QTabBar::tab {
	background-color: #EE2028;
	border-color: #FFFFFF;
	border-radius: 5px;
	border-style: solid;
	border-width: 2px;
	color: #FFFFFF;
	margin: 1px;
	min-height: 30px;
}
QTabBar::tab:top {
	border-color: #FFFFFF;
	border-radius: 5px;
	border-style: solid;
	border-width: 2px;
	min-width: 120px;
	margin-left: 11px;
	padding-bottom: 5px;
	padding-left: 6px;
	padding-right: 6px;
	padding-top: 5px;
}
QTabBar::tab:top:selected {
	background-color: #FFE01B;
	border-color: #271F24;
	color: #271F24;
}
QTabBar::tab:hover {
	background-color: #02A64F;
	border-color: #FFCFFE;
	color: #FFCFFE;
}
QTabBar::tab::selected:hover {
	background-color: #23221E;
	border-color: #FFFBF3;
	color: #E32528;
}
QTabBar::tab:left {
	background-color: #027BC1;
	border-color: #FFFFFF;
	border-radius: 5px;
	border-style: solid;
	border-width: 2px;
	min-width: 200px;
}
QTabBar::tab:left:last {
	margin-bottom: 0px;
}
QTabBar::tab:left:selected {
	background-color: #23221E;
	border-color: #FFE01B;
	color: #271F24;
	border-radius: 5px;
	border-style: solid;
	border-width: 2px;
}
QTabBar::tab:left:selected:hover {
	background-color: #23221E;
	border-color: #E32528;
	color: #E32528;
	border-radius: 5px;
	border-style: solid;
	border-width: 2px;
}
QTabBar::tab:left:hover {
	background-color: #02A64F;
	border-color: #FFCFFE;
	color: #FFCFFE;
	border-radius: 5px;
	border-style: solid;
	border-width: 2px;
}
