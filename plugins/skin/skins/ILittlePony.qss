QRadioButton::indicator:unchecked:pressed {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0.01 #B8CDF2, stop:0.18 #3F96FF, stop:0.39 #7791FF, stop:0.50 #938DFF, stop:0.63 #A06DFF, stop:0.75 #CD69FF, stop:0.88 #DC66FF, stop:0.97 #F564FF, stop:1 #DBD9F1);
}
QRadioButton::indicator:checked:pressed {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0.01 #B8CDF2, stop:0.18 #3F96FF, stop:0.39 #7791FF, stop:0.50 #938DFF, stop:0.63 #A06DFF, stop:0.75 #CD69FF, stop:0.88 #DC66FF, stop:0.97 #F564FF, stop:1 #DBD9F1);
