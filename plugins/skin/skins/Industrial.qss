QWidget {
	background-color: transparent;
	border: none;
	color: #FFFFFF;
	font: bold;
}
QAbstractScrollArea,QDeclarativeView {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0.25 #737375, stop:1 #414143);
}
QGraphicsView {
	background-color: #000000;
}
QMainWindow {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0.25 #737375, stop:1 #414143);
}
QDialog {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0.25 #737375, stop:1 #414143);
}
QColorDialog {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0.25 #737375, stop:1 #414143);
}
QTextEdit {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0.25 #737375, stop:1 #414143);
	color: #FFFFFF;
}
QTimeEdit, QDateTimeEdit, QDateEdit, QToolBox, QToolBox::tab, QToolBox::tab:selected, QScrollArea {
	background-color: transparent;	
}
QPlainTextEdit {
	background-color: #000000;
	border-color: #FFFFFF;
	border-radius: 5px;
	border-style: solid;
	border-width: 2px;
	color: #FFFFFF;
	font-size: 11px;
	padding: 1px;
	selection-color: #FFFFFF;
	selection-background-color: #000000;
}
QToolButton {
	background-color: qradialgradient(spread:pad, cx: 0.5, cy: 0.5, fx: 0.5, fy: 0.5, radius: 1.0, stop:0.10 #FFE01B, stop:0.20 #E6C700, stop:1 #271F24);
	border-color: #000000;
	border-radius: 5px;
	border-style: solid;
	border-width: 2px;
	color: #000000;
	font-size: 11px;
	min-height: 18px;
}
QToolButton:hover {
	background-color: qradialgradient(spread:pad, cx: 0.5, cy: 0.5, fx: 0.5, fy: 0.5, radius: 1.0, stop:0.10 #66FF66, stop:0.20 #00E600, stop:1 #271F24);
