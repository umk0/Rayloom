{
  "name": "rayloom",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "license": "GPL-2.0-or-later",
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.17"
    }
  },
  "main": "desktop/main.cjs",
  "scripts": {
    "build": "node scripts/build-renderer.mjs",
    "build:portable": "node scripts/build-renderer.mjs && node scripts/build-portable-release.mjs",
    "start": "electron .",
    "test:core": "node scripts/smoke-core.mjs",
    "test:effects": "node scripts/test-effects.mjs",
    "test:plugins": "node scripts/test-plugins.mjs",
    "test:media": "node scripts/test-media.mjs",
    "test:studio": "node scripts/test-studio.mjs",
    "test:runtime": "node scripts/test-studio-runtime.mjs",
    "test:background": "node scripts/test-background-runtime.mjs",
    "test:canvas": "electron scripts/test-canvas.cjs",
    "test:ui": "node scripts/test-mantine-ui.mjs",
    "test:portable": "node scripts/test-portable-release.mjs",
    "test:authoring": "node scripts/test-mantine-authoring.mjs",
    "test:ui:legacy": "node scripts/test-ui.mjs",
    "test:fullscreen": "node scripts/test-mantine-ui.mjs",
    "test:fullscreen:legacy": "node scripts/test-fullscreen.mjs",
    "test:previews": "node scripts/test-effect-previews.mjs",
    "test:close": "node scripts/test-runtime-close.mjs",
    "test:hardware": "node scripts/test-hardware-studio.mjs",
    "catalog:update": "node scripts/update-device-catalog.mjs",
    "sdk:validate": "node sdk/validate.mjs sdk/examples/reactor/manifest.json",
    "test:persistence": "node scripts/test-persistence.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@mantine/core": "9.7.4",
    "@mantine/form": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "@monaco-editor/react": "4.7.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "0.57.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "45.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
