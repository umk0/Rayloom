QToolButton:disabled {
	background-color: transparent;
	border-color: qlineargradient(x1:1, y1:0.02, x2:0, y2:0, stop:0 #271F24, stop:0.09 #271F24, stop:0.10 #FFE01B, stop:0.19 #FFE01B, stop:0.20 #271F24, stop:0.29 #271F24, stop:0.30 #FFE01B, stop:0.39 #FFE01B, stop:0.40 #271F24, stop:0.49 #271F24, stop:0.50 #FFE01B, stop:0.59 #FFE01B, stop:0.60 #271F24, stop:0.69 #271F24, stop:0.70 #FFE01B, stop:0.79 #FFE01B, stop:0.80 #271F24, stop:0.89 #271F24, stop:0.90 #FFE01B, stop:0.95 #FFE01B, stop:1 #271F24);
