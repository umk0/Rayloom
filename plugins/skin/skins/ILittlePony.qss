QWidget {
	background-color: transparent;
	border: none;
	color: #FFFFFF;
	font: bold;
}
QAbstractScrollArea,QDeclarativeView {
	background-color: #0033CC;
}
QGraphicsView {
	background-color: #999999;
}
QMainWindow {
	background-color: qradialgradient(cx: 1, cy: 1, fx: 1, fy: 1, radius: 0.5, stop:0.15 #3366FF, stop:0.60 #0033CC, stop:0.65 #FF00BF, stop:0.74 #0080FF, stop:0.78 #00FF40, stop:0.82 #FFFF00, stop:0.86 #FFBF00, stop:0.90 #FF3300, stop:0.95 #0033CC);
}
QDialog {
	background-color: #0033CC;
}
QColorDialog {
	background-color: #0033CC;
}
QTextEdit {
	background-color: #0033CC;
	color: #FFFFFF;
}
QPlainTextEdit {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0.85 #0033CC, stop:0.87 #FF3300, stop:0.89 #FFBF00, stop:0.91 #FFFF00, stop:0.93 #00FF40, stop:0.95 #7791FF, stop:0.97 #FF00BF, stop:0.99 #0033CC);
	border-color: #FFFFFF;
	border-radius: 10px;
	border-style: solid;
	border-width: 2px;
	color: #FFFFFF;
	font-size: 11px;
	padding: 1px;
	selection-color: #FFFFFF;
	selection-background-color: #FF00BF;
}
QToolButton {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0.01 #B8CDF2, stop:0.18 #3F96FF, stop:0.39 #7791FF, stop:0.50 #938DFF, stop:0.63 #A06DFF, stop:0.75 #CD69FF, stop:0.88 #DC66FF, stop:0.97 #F564FF, stop:1 #DBD9F1);
	border-color: #FFFFFF;
	border-radius: 10px;
	border-style: solid;
	border-width: 2px;
	font-size: 11px;
	min-height: 18px;
}
QToolButton:hover {
	background-color: qradialgradient(cx: 0.5, cy: 0.5, fx: 0.5, fy: 0.5, radius: 1.0, stop:0.10 #3F96FF, stop:0.26 #7791FF, stop:0.39 #938DFF, stop:0.42 #A06DFF, stop:0.58 #CD69FF, stop:0.71 #DC66FF, stop:0.84 #F564FF, stop:1 #DBD9F1);
	border-bottom-color: #DC66FF;
	border-left-color: #CD69FF;
	border-right-color: #CD69FF;
	border-top-color: #DC66FF;
}
QToolButton:pressed, QToolButton:checked:pressed {
	background-color: qlineargradient(spread:pad, x1:0, y1:1, x2:0, y2:0, stop:0.01 #B8CDF2, stop:0.18 #3F96FF, stop:0.39 #7791FF, stop:0.50 #938DFF, stop:0.63 #A06DFF, stop:0.75 #CD69FF, stop:0.88 #DC66FF, stop:0.97 #F564FF, stop:1 #DBD9F1);
	color: #FFFFFF;
}
QToolButton:checked {
	background-color: qradialgradient(cx: 0.5, cy: 0.5, fx: 0.5, fy: 0.5, radius: 1.0, stop:0.10 #F564FF, stop:0.26 #DC66FF, stop:0.39 #CD69FF, stop:0.42 #A06DFF, stop:0.58 #938DFF, stop:0.71 #7791FF, stop:0.84 #3F96FF, stop:1 #B8CDF2);
	color: #FFFFFF;
	padding-bottom: 1px;
	padding-top: -1px;
}
QToolButton:checked:hover {
	background-color: qradialgradient(cx: 0.5, cy: 0.5, fx: 0.5, fy: 0.5, radius: 1.0, stop:0.10 #F564FF, stop:0.26 #DC66FF, stop:0.39 #CD69FF, stop:0.42 #A06DFF, stop:0.58 #938DFF, stop:0.71 #7791FF, stop:0.84 #3F96FF, stop:1 #B8CDF2);
	border-bottom-color: #7791FF;
	border-left-color: #938DFF;
	border-right-color: #938DFF;
	border-top-color: #7791FF;
}
QToolButton:disabled {
	background-color: transparent;
	border-color: #7791FF;
	border-radius: 11px;
	border-style: solid;
	border-width: 2px;
	color: #7791FF;
}
QToolButton::indicator {
	background: none;
}
QPushButton {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0.01 #B8CDF2, stop:0.18 #3F96FF, stop:0.39 #7791FF, stop:0.50 #938DFF, stop:0.63 #A06DFF, stop:0.75 #CD69FF, stop:0.88 #DC66FF, stop:0.97 #F564FF, stop:1 #DBD9F1);
	border-color: #FFFFFF;
	border-radius: 10px;
	border-style: solid;
	border-width: 2px;
	height: 18px;
	font-size: 11px;
	min-width: 50px;
	padding: 4px;
}
QPushButton:hover {
	background-color: qradialgradient(cx: 0.5, cy: 0.5, fx: 0.5, fy: 0.5, radius: 1.0, stop:0.10 #3F96FF, stop:0.26 #7791FF, stop:0.39 #938DFF, stop:0.42 #A06DFF, stop:0.58 #CD69FF, stop:0.71 #DC66FF, stop:0.84 #F564FF, stop:1 #DBD9F1);
	border-bottom-color: #DC66FF;
	border-left-color: #CD69FF;
	border-right-color: #CD69FF;
	border-top-color: #DC66FF;
}
QPushButton:pressed, QPushButton:checked:pressed {
	background-color: qlineargradient(spread:pad, x1:0, y1:1, x2:0, y2:0, stop:0.01 #B8CDF2, stop:0.18 #3F96FF, stop:0.39 #7791FF, stop:0.50 #938DFF, stop:0.63 #A06DFF, stop:0.75 #CD69FF, stop:0.88 #DC66FF, stop:0.97 #F564FF, stop:1 #DBD9F1);
	color: #FFFFFF;
}
QPushButton:checked:hover {
	background-color: qradialgradient(cx: 0.5, cy: 0.5, fx: 0.5, fy: 0.5, radius: 1.0, stop:0.10 #F564FF, stop:0.26 #DC66FF, stop:0.39 #CD69FF, stop:0.42 #A06DFF, stop:0.58 #938DFF, stop:0.71 #7791FF, stop:0.84 #3F96FF, stop:1 #B8CDF2);
	border-bottom-color: #7791FF;
	border-left-color: #938DFF;
	border-right-color: #938DFF;
	border-top-color: #7791FF;
}
QPushButton:disabled {
	background-color: transparent;
	border-color: #7791FF;
	border-radius: 11px;
	border-style: solid;
	border-width: 2px;
	color: #7791FF;
}
QLineEdit {
	background-color: #0033CC;
	border-bottom-color: #7791FF;
	border-left-color: #938DFF;
	border-radius: 10px;
	border-right-color: #938DFF;
	border-style: solid;
	border-top-color: #7791FF;
	border-width: 2px;
	color: #FFFFFF;
	font-size: 11px;
	min-height: 18px;
	padding-bottom: 2px;
	padding-left: 2px;
	selection-background-color: #FF00BF;
	selection-color: #FFFFFF;
}
QLineEdit:hover {
	background-color: qradialgradient(cx: 0.5, cy: 0.5, fx: 0.5, fy: 0.5, radius: 1.0, stop:0.10 #3F96FF, stop:0.26 #7791FF, stop:0.39 #938DFF, stop:0.42 #A06DFF, stop:0.58 #CD69FF, stop:0.71 #DC66FF, stop:0.84 #F564FF, stop:1 #DBD9F1);
	border-bottom-color: #DC66FF;
	border-left-color: #CD69FF;
	border-right-color: #CD69FF;
	border-top-color: #DC66FF;
}
QLabel {
	color: #FFFFFF;
}
QLCDNumber {
	color: #FF00BF;
}
QProgressBar {
	background-color: #0033CC;
	border-color: #FFFFFF;
	border-radius: 10px;
	border-style: solid;
	border-width: 2px;
	color: #FFFFFF;
	font-size: 11px;
	height: 26px;
	text-align: center;
}
QProgressBar::chunk {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0.01 #DBD9F1, stop:0.18 #FF00BF, stop:0.31 #5DA4FA, stop:0.44 #5095FF, stop:0.57 #988DFF, stop:0.70 #AA6CFF, stop:0.83 #BB56CC, stop:0.99 #F564FF, stop:1 #DBD9F1);
	border-color: #FF00BF;
	border-radius: 8px;
	border-style: solid;
	border-width: 2px;
}
QMenuBar {
	background-color: #0033CC;
}
QMenuBar::item {
  	background-color: #0033CC;
	color: #FFFFFF;
  	padding: 1px 4px;
  	spacing: 3px;
}
QMenuBar::item:selected {
  	background-color: #FF00BF;
	color: #0033CC;
}
QMenu {
	background-color: #0033CC;
	font-size: 11px;
	padding: 0px;
}
QMenu::item {
	background-color: #0033CC;
	border-color: transparent;
	border-radius: 10px;
	border-style: solid;
	border-width: 2px;
	color: #FFFFFF;
	font-size: 11px;
	min-width: 80px;
	padding-bottom: 2px;
	padding-left: 10px;
	padding-right: 10px;
	padding-top: 2px;
}
QMenu::item:selected {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0.01 #B8CDF2, stop:0.18 #3F96FF, stop:0.39 #7791FF, stop:0.50 #938DFF, stop:0.63 #A06DFF, stop:0.75 #CD69FF, stop:0.88 #DC66FF, stop:0.97 #F564FF, stop:1 #DBD9F1);
	border-color: #FFFFFF;
}
QMenu::item:pressed {
	background-color: qlineargradient(spread:pad, x1:1, y1:0, x2:0, y2:0, stop:0.01 #B8CDF2, stop:0.18 #3F96FF, stop:0.39 #7791FF, stop:0.50 #938DFF, stop:0.63 #A06DFF, stop:0.75 #CD69FF, stop:0.88 #DC66FF, stop:0.97 #F564FF, stop:1 #DBD9F1);
}
QTabWidget {
	background-color: #0033CC;
	color: #FFFFFF;
}
QTabWidget::pane {
	background: none;
	border: none;
	padding-top: -2px;
}
QTabBar::tab {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0.01 #B8CDF2, stop:0.18 #3F96FF, stop:0.39 #7791FF, stop:0.50 #938DFF, stop:0.63 #A06DFF, stop:0.75 #CD69FF, stop:0.88 #DC66FF, stop:0.97 #F564FF, stop:1 #DBD9F1);
	border-color: #FFFFFF;
	border-radius: 10px;
	border-style: solid;
	border-width: 2px;
	color: #FFFFFF;
	margin: 1px;
	min-height: 30px;
}
QTabBar::tab:top {
	border-color: #FFFFFF;
	border-radius: 10px;
	border-style: solid;
	border-width: 2px;
	min-width: 120px;
	margin-left: 11px;
	padding-bottom: 5px;
	padding-left: 6px;
	padding-right: 6px;
	padding-top: 5px;
}
QTabBar::tab:top:selected {
	background-color: qradialgradient(cx: 0.5, cy: 0.5, fx: 0.5, fy: 0.5, radius: 1.0, stop:0.10 #F564FF, stop:0.26 #DC66FF, stop:0.39 #CD69FF, stop:0.42 #A06DFF, stop:0.58 #938DFF, stop:0.71 #7791FF, stop:0.84 #3F96FF, stop:1 #B8CDF2);
}
QTabBar::tab:hover {
	background-color: qradialgradient(cx: 0.5, cy: 0.5, fx: 0.5, fy: 0.5, radius: 1.0, stop:0.10 #3F96FF, stop:0.26 #7791FF, stop:0.39 #938DFF, stop:0.42 #A06DFF, stop:0.58 #CD69FF, stop:0.71 #DC66FF, stop:0.84 #F564FF, stop:1 #DBD9F1);
	border-bottom-color: #DC66FF;
	border-left-color: #CD69FF;
	border-right-color: #CD69FF;
	border-top-color: #DC66FF;
}
QTabBar::tab::selected:hover {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0.01 #B8CDF2, stop:0.18 #3F96FF, stop:0.39 #7791FF, stop:0.50 #938DFF, stop:0.63 #A06DFF, stop:0.75 #CD69FF, stop:0.88 #DC66FF, stop:0.97 #F564FF, stop:1 #DBD9F1);
	border-bottom-color: #7791FF;
	border-left-color: #938DFF;
	border-right-color: #938DFF;
	border-top-color: #7791FF;
}
QTabBar::tab:left {
	border-color: #FFFFFF;
	border-radius: 10px;
	border-style: solid;
	border-width: 2px;
}
QTabBar::tab:left:last {
	margin-bottom: 0px;
}
QTabBar::tab:left:selected {
	background-color: qradialgradient(cx: 0.5, cy: 0.5, fx: 0.5, fy: 0.5, radius: 1.0, stop:0.10 #F564FF, stop:0.26 #DC66FF, stop:0.39 #CD69FF, stop:0.42 #A06DFF, stop:0.58 #938DFF, stop:0.71 #7791FF, stop:0.84 #3F96FF, stop:1 #B8CDF2);
	border-color: #FFFFFF;
	border-radius: 10px;
	border-style: solid;
	border-width: 2px;
}
QTabBar::tab:left:selected:hover {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0.01 #B8CDF2, stop:0.18 #3F96FF, stop:0.39 #7791FF, stop:0.50 #938DFF, stop:0.63 #A06DFF, stop:0.75 #CD69FF, stop:0.88 #DC66FF, stop:0.97 #F564FF, stop:1 #DBD9F1);
	border-bottom-color: #7791FF;
	border-left-color: #938DFF;
	border-radius: 10px;
	border-right-color: #938DFF;
	border-style: solid;
	border-top-color: #7791FF;
	border-width: 2px;
}
QTabBar::tab:left:hover {
	background-color: qradialgradient(cx: 0.5, cy: 0.5, fx: 0.5, fy: 0.5, radius: 1.0, stop:0.10 #3F96FF, stop:0.26 #7791FF, stop:0.39 #938DFF, stop:0.42 #A06DFF, stop:0.58 #CD69FF, stop:0.71 #DC66FF, stop:0.84 #F564FF, stop:1 #DBD9F1);
	border-bottom-color: #DC66FF;
	border-left-color: #CD69FF;
	border-radius: 10px;
	border-right-color: #CD69FF;
	border-style: solid;
	border-top-color: #DC66FF;
	border-width: 2px;
}
QCheckBox {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0.01 #B8CDF2, stop:0.18 #3F96FF, stop:0.39 #7791FF, stop:0.50 #938DFF, stop:0.63 #A06DFF, stop:0.75 #CD69FF, stop:0.88 #DC66FF, stop:0.97 #F564FF, stop:1 #DBD9F1);
	border-color: #FFFFFF;
	border-radius: 10px;
	border-style: solid;
	border-width: 2px;
	color: #FFFFFF;
	min-height: 18px;
	padding: 4px;
}
QCheckBox:disabled {
	background-color: transparent;
	border-color: #7791FF;
	border-radius: 11px;
	border-style: solid;
	border-width: 2px;
	color: #7791FF;
	padding-left: 3px;
}
QCheckBox:checked:hover {
	background-color: qradialgradient(cx: 0.5, cy: 0.5, fx: 0.5, fy: 0.5, radius: 1.0, stop:0.10 #F564FF, stop:0.26 #DC66FF, stop:0.39 #CD69FF, stop:0.42 #A06DFF, stop:0.58 #938DFF, stop:0.71 #7791FF, stop:0.84 #3F96FF, stop:1 #B8CDF2);
	border-bottom-color: #7791FF;
	border-left-color: #938DFF;
	border-right-color: #938DFF;
	border-top-color: #7791FF;
}
QCheckBox:unchecked:!disabled {
	border-color: #FFFFFF;
}
QCheckBox:unchecked:!disabled:hover {
	background-color: qradialgradient(cx: 0.5, cy: 0.5, fx: 0.5, fy: 0.5, radius: 1.0, stop:0.10 #3F96FF, stop:0.26 #7791FF, stop:0.39 #938DFF, stop:0.42 #A06DFF, stop:0.58 #CD69FF, stop:0.71 #DC66FF, stop:0.84 #F564FF, stop:1 #DBD9F1);
	border-bottom-color: #DC66FF;
	border-left-color: #CD69FF;
	border-right-color: #CD69FF;
	border-top-color: #DC66FF;
}
QCheckBox::indicator:checked {
	background-color: qlineargradient(spread:pad, x1:0, y1:1, x2:0, y2:0, stop:0.01 #B8CDF2, stop:0.18 #3F96FF, stop:0.39 #7791FF, stop:0.50 #938DFF, stop:0.63 #A06DFF, stop:0.75 #CD69FF, stop:0.88 #DC66FF, stop:0.97 #F564FF, stop:1 #DBD9F1);
	border-color: #FFFFFF;
	border-radius: 5px;
	border-style: solid;
	border-width: 1px;
	height: 10px;
	width: 10px;
}
QCheckBox::indicator:unchecked {
	background-color: #FFFFFF;
	border-color: #CD69FF;
	border-radius: 5px;
	border-style: solid;
	border-width: 1px;
	height: 10px;
	width: 10px;
}
QCheckBox::indicator:unchecked:hover {
	background-color: #CD69FF;
	border-color: #FFFFFF;
}
QCheckBox::indicator:checked:hover {
	background-color: #938DFF;
}
QCheckBox::indicator:unchecked:pressed {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0.01 #B8CDF2, stop:0.18 #3F96FF, stop:0.39 #7791FF, stop:0.50 #938DFF, stop:0.63 #A06DFF, stop:0.75 #CD69FF, stop:0.88 #DC66FF, stop:0.97 #F564FF, stop:1 #DBD9F1);
}
QCheckBox::indicator:checked:pressed {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0.01 #B8CDF2, stop:0.18 #3F96FF, stop:0.39 #7791FF, stop:0.50 #938DFF, stop:0.63 #A06DFF, stop:0.75 #CD69FF, stop:0.88 #DC66FF, stop:0.97 #F564FF, stop:1 #DBD9F1);
}
QCheckBox::indicator:disabled {
	background-color: qlineargradient(x1:1, y1:1, x2:0, y2:0, stop:0.44 transparent, stop:0.45 #7791FF, stop:0.55 #7791FF, stop:0.56 transparent);
	border-color: #7791FF;
}
QRadioButton {
	background-color: transparent;
