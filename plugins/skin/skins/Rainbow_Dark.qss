QWidget {
	background-color: transparent;
	border: none;
	color: #E6E6E6;
	font: normal;
}
QAbstractScrollArea,QDeclarativeView {
	background-color: #383838;
}
QGraphicsView {
	background-color: #999999;
}
QMainWindow {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0.65 #383838, stop:0.70 #FF3300, stop:0.74 #FFBF00, stop:0.78 #FFFF00, stop:0.82 #00FF40, stop:0.86 #0080FF, stop:0.90 #FF00BF, stop:0.95 #383838);
}
QDialog {
	background-color: #383838;
}
QColorDialog {
	background-color: #383838;
}
QTextEdit {
	background-color: #383838;
	color: #E6E6E6;
}
QPlainTextEdit {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0.85 #383838, stop:0.87 #FF3300, stop:0.89 #FFBF00, stop:0.91 #FFFF00, stop:0.93 #00FF40, stop:0.95 #0080FF, stop:0.97 #FF00BF, stop:0.99 #383838);
	border-radius: 10px;
	border-style: groove;
	border-width: 2px;
	color: #E6E6E6;
	font-size: 11px;
	padding: 1px;
	selection-color: #FFFFFF;
	selection-background-color: #FF00BF;
}
QToolButton {
	background-color: #383838;
	border-color: #FF00BF;
	border-radius: 11px;
	border-style: groove;
	border-width: 2px;
	font-size: 11px;
	min-height: 18px;
}
QToolButton:hover {
	border-color: #00FF40;
}
QToolButton:pressed, QToolButton:checked:pressed {
	background-color: #FFBF00;
	color: #E6E6E6;
}
QToolButton:checked {
	background-color: #00FF40;
	color: #E6E6E6;
	padding-bottom: 1px;
	padding-top: -1px;
}
QToolButton:checked:hover {
	border-color: #FFFF00;
}
QToolButton:disabled {
	background-color: transparent;
	border-color: #0080FF;
	border-radius: 11px;
	border-style: groove;
	border-width: 2px;
	color: #0080FF;
}
QToolButton::indicator {
	background: none;
}
QPushButton {
	background-color: #383838;
	border-color: #FF00BF;
	border-radius: 11px;
	border-style: groove;
	border-width: 2px;
	height: 18px;
	font-size: 11px;
	min-width: 50px;
	padding: 4px;
}
QPushButton:hover {
	border-color: #00FF40;
}
QPushButton:pressed, QPushButton:checked:pressed {
	background-color: #FFBF00;
	color: #E6E6E6;
}
QPushButton:checked:hover {
	border-color: #FFFF00;
}
QPushButton:disabled {
	background-color: transparent;
	border-color: #0080FF;
	border-radius: 11px;
	border-style: groove;
	border-width: 2px;
	color: #0080FF;
}
QLineEdit {
	background-color: #383838;
	border-color: #FF00BF;
	border-radius: 11px;
	border-style: groove;
	border-width: 2px;
	color: #E6E6E6;
	font-size: 11px;
	min-height: 18px;
	padding-bottom: 2px;
	padding-left: 2px;
	selection-background-color: #FF00BF;
	selection-color: #FFFFFF;
}
QLineEdit:hover {
	border-color: #00FF40;
}
QLabel {
	color: #E6E6E6;
}
QLCDNumber {
	color: #FF00BF;
}
QProgressBar {
	background-color: #383838;
	border-color: #FF00BF;
	border-radius: 11px;
	border-style: groove;
	border-width: 2px;
	color: #E6E6E6;
	font-size: 11px;
	height: 26px;
	text-align: center;
}
QProgressBar::chunk {
	background-color: #0080FF;
	border-color: #FF00BF;
	border-radius: 10px;
	border-style: inset;
	border-width: 2px;
}
QMenuBar {
	background-color: #383838;
}
QMenuBar::item {
  	background-color: #383838;
	color: #E6E6E6;
  	padding: 1px 4px;
  	spacing: 3px;
}
QMenuBar::item:selected {
  	background-color: #FF00BF;
	color: #383838;
}
QMenu {
	background-color: #383838;
	font-size: 11px;
	padding: 0px;
}
QMenu::item {
	background-color: #383838;
	border: none;
	color: #E6E6E6;
	font-size: 11px;
	min-width: 80px;
	padding-bottom: 4px;
	padding-left: 15px;
	padding-right: 15px;
	padding-top: 4px;
}
QMenu::item:selected {
	border-bottom: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0.40 transparent, stop:0.50 #FF3300, stop:0.60 #FFBF00, stop:0.70 #FFFF00, stop:0.80 #00FF40, stop:0.90 #0080FF, stop:1 #FF00BF);
	border-left: qlineargradient(spread:pad, x1:0, y1:1, x2:0, y2:0, stop:0.40 transparent, stop:0.50 #FF3300, stop:0.60 #FFBF00, stop:0.70 #FFFF00, stop:0.80 #00FF40, stop:0.90 #0080FF, stop:1 #FF00BF);
	border-right: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0.40 transparent, stop:0.50 #FF3300, stop:0.60 #FFBF00, stop:0.70 #FFFF00, stop:0.80 #00FF40, stop:0.90 #0080FF, stop:1 #FF00BF);
	border-top: qlineargradient(spread:pad, x1:1, y1:0, x2:, y2:0, stop:0.40 transparent, stop:0.50 #FF3300, stop:0.60 #FFBF00, stop:0.70 #FFFF00, stop:0.80 #00FF40, stop:0.90 #0080FF, stop:1 #FF00BF);
	border-style: double;
	border-width: 1px;
	color: #E6E6E6;
	padding-left: 13px;
}
QTabWidget {
	background-color: #383838;
	color: #E6E6E6;
}
QTabWidget::pane {
	background: none;
	border: none;
	padding-top: -2px;
}
QTabWidget::tab-bar:top {
    alignment: center;
}
QTabBar::tab {
	background-color: qlineargradient(spread:pad, x1:1, y1:1, x2:0, y2:0, stop:0.65 transparent, stop:0.70 #FF00BF, stop:0.74 #0080FF, stop:0.78 #00FF40, stop:0.82 #FFFF00, stop:0.86 #FFBF00, stop:0.90 #FF3300, stop:0.95 transparent);
	border-style: solid;
	border-color: transparent;
	border-width: 1px;
	margin: 1px;
	min-height: 30px;
}
QTabBar::tab:top {
	border-style: solid;
	border-color: transparent;
	border-width: 1px;
	min-width: 150px;
	margin-left: 40px;
	padding-left: 5px;
	padding-right: 5px;
}
QTabBar::tab:top:selected {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0.65 transparent, stop:0.70 #FF3300, stop:0.74 #FFBF00, stop:0.78 #FFFF00, stop:0.82 #00FF40, stop:0.86 #0080FF, stop:0.90 #FF00BF, stop:0.95 transparent);
	border-bottom: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0.40 transparent, stop:0.50 #FF3300, stop:0.60 #FFBF00, stop:0.70 #FFFF00, stop:0.80 #00FF40, stop:0.90 #0080FF, stop:1 #FF00BF);
	border-right: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0.40 transparent, stop:0.50 #FF3300, stop:0.60 #FFBF00, stop:0.70 #FFFF00, stop:0.80 #00FF40, stop:0.90 #0080FF, stop:1 #FF00BF);
	border-style: double;
	border-width: 1px;
	padding-top: -4px;
}
QTabBar::tab:hover {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0.40 transparent, stop:0.45 #FF3300, stop:0.50 #FFBF00, stop:0.55 #FFFF00, stop:0.60 #00FF40, stop:0.65 #0080FF, stop:0.70 #FF00BF, stop:0.75 transparent);
	border-left: qlineargradient(spread:pad, x1:0, y1:1, x2:0, y2:0, stop:0.40 transparent, stop:0.50 #FF3300, stop:0.60 #FFBF00, stop:0.70 #FFFF00, stop:0.80 #00FF40, stop:0.90 #0080FF, stop:1 #FF00BF);
	border-top: qlineargradient(spread:pad, x1:1, y1:0, x2:, y2:0, stop:0.40 transparent, stop:0.50 #FF3300, stop:0.60 #FFBF00, stop:0.70 #FFFF00, stop:0.80 #00FF40, stop:0.90 #0080FF, stop:1 #FF00BF);
	border-style: double;
	border-width: 1px;
	padding-top: -4px;
}
QTabBar::tab:left {
	margin-bottom: 2px;
	margin-top: 1px;
}
QTabBar::tab:left:selected {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0.65 transparent, stop:0.70 #FF3300, stop:0.74 #FFBF00, stop:0.78 #FFFF00, stop:0.82 #00FF40, stop:0.86 #0080FF, stop:0.90 #FF00BF, stop:0.95 transparent);
	border-bottom: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0.40 transparent, stop:0.50 #FF3300, stop:0.60 #FFBF00, stop:0.70 #FFFF00, stop:0.80 #00FF40, stop:0.90 #0080FF, stop:1 #FF00BF);
	border-right: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0.40 transparent, stop:0.50 #FF3300, stop:0.60 #FFBF00, stop:0.70 #FFFF00, stop:0.80 #00FF40, stop:0.90 #0080FF, stop:1 #FF00BF);
	border-style: double;
	border-width: 1px;
}
QTabBar::tab:left:selected:hover {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0.65 transparent, stop:0.70 #FF3300, stop:0.74 #FFBF00, stop:0.78 #FFFF00, stop:0.82 #00FF40, stop:0.86 #0080FF, stop:0.90 #FF00BF, stop:0.95 transparent);
	border-left: qlineargradient(spread:pad, x1:0, y1:1, x2:0, y2:0, stop:0.40 transparent, stop:0.50 #FF3300, stop:0.60 #FFBF00, stop:0.70 #FFFF00, stop:0.80 #00FF40, stop:0.90 #0080FF, stop:1 #FF00BF);
	border-top: qlineargradient(spread:pad, x1:1, y1:0, x2:, y2:0, stop:0.40 transparent, stop:0.50 #FF3300, stop:0.60 #FFBF00, stop:0.70 #FFFF00, stop:0.80 #00FF40, stop:0.90 #0080FF, stop:1 #FF00BF);
	border-style: double;
	border-width: 1px;
}
QTabBar::tab:left:hover {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0.40 transparent, stop:0.45 #FF3300, stop:0.50 #FFBF00, stop:0.55 #FFFF00, stop:0.60 #00FF40, stop:0.65 #0080FF, stop:0.70 #FF00BF, stop:0.75 transparent);
	border-left: qlineargradient(spread:pad, x1:0, y1:1, x2:0, y2:0, stop:0.40 transparent, stop:0.50 #FF3300, stop:0.60 #FFBF00, stop:0.70 #FFFF00, stop:0.80 #00FF40, stop:0.90 #0080FF, stop:1 #FF00BF);
	border-top: qlineargradient(spread:pad, x1:1, y1:0, x2:, y2:0, stop:0.40 transparent, stop:0.50 #FF3300, stop:0.60 #FFBF00, stop:0.70 #FFFF00, stop:0.80 #00FF40, stop:0.90 #0080FF, stop:1 #FF00BF);
	border-style: double;
	border-width: 1px;
}
QCheckBox {
	background-color: transparent;
	border-color: #FF00BF;
	border-radius: 11px;
	border-style: groove;
	border-width: 2px;
	color: #E6E6E6;
	min-height: 18px;
	padding: 4px;
}
QCheckBox:disabled {
	background-color: transparent;
	border-color: #0080FF;
	border-radius: 11px;
	border-style: groove;
	border-width: 2px;
	color: #0080FF;
	padding-left: 3px;
}
QCheckBox:checked:hover {
	border-color: #FF3300;
}
QCheckBox:unchecked:!disabled{
	border-color: #FF3300;
}
QCheckBox:unchecked:!disabled:hover{
	border-color: #00FF40;
}
QCheckBox::indicator:checked {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0.17 #FF3300, stop:0.34 #FFBF00, stop:0.51 #FFFF00, stop:0.68 #00FF40, stop:0.85 #0080FF, stop:1 #FF00BF);
	border-color: #FF00BF;
	border-radius: 7px;
	border-style: ridge;
	border-width: 2px;
	height: 10px;
	width: 10px;
}
QCheckBox::indicator:unchecked {
	background-color: #FFFFFF;
	border-color: #FF3300;
	border-radius: 7px;
	border-style: ridge;
	border-width: 2px;
	height: 10px;
	width: 10px;
}
QCheckBox::indicator:unchecked:hover {
	background-color: #00FF40;
}
QCheckBox::indicator:checked:hover {
	background-color: #FF3300;
}
QCheckBox::indicator:unchecked:pressed {
	background-color: #FFBF00;
}
QCheckBox::indicator:checked:pressed {
	background-color: #FFBF00;
}
QCheckBox::indicator:disabled {
	background-color: qlineargradient(x1:1, y1:1, x2:0, y2:0, stop:0.44 transparent, stop:0.45 #FFFF00, stop:0.55 #FFFF00, stop:0.56 transparent);
	border-color: #FFFF00;
}
QRadioButton {
	background-color: transparent;
	border-color: #FF00BF;
	border-radius: 11px;
	border-style: groove;
	border-width: 2px;
	color: #E6E6E6;
	font-size: 11px;
	padding: 2px;
}
QRadioButton:disabled {
	background-color: transparent;
	border-color: #0080FF;
	border-radius: 11px;
	border-style: groove;
	border-width: 2px;
	color: #0080FF;
}
QRadioButton:hover {
	border-color: #00FF40;
}
QRadioButton:checked:hover {
	border-color: #FF3300;
}
QRadioButton:unchecked:!disabled{
	border-color: #FF00BF;
}
QRadioButton:unchecked:!disabled:hover{
	border-color: #00FF40;
}
QRadioButton::indicator:checked {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0.17 #FF3300, stop:0.34 #FFBF00, stop:0.51 #FFFF00, stop:0.68 #00FF40, stop:0.85 #0080FF, stop:1 #FF00BF);
	border-color: #FF00BF;
	border-radius: 7px;
	border-style: ridge;
	border-width: 2px;
	height: 10px;
	width: 10px;
}
QRadioButton::indicator:unchecked {
	background-color: #FFFFFF;
	border-color: #FF3300;
	border-radius: 7px;
	border-style: ridge;
	border-width: 2px;
	height: 10px;
	width: 10px;
}
QRadioButton::indicator:unchecked:hover {
	background-color: #00FF40;
}
QRadioButton::indicator:checked:hover {
	background-color: #FF3300;
}
QRadioButton::indicator:unchecked:pressed {
	background-color: #FFBF00;
}
QRadioButton::indicator:checked:pressed {
	background-color: #FFBF00;
}
QRadioButton::indicator:disabled {
	background-color: qlineargradient(x1:1, y1:1, x2:0, y2:0, stop:0.44 transparent, stop:0.45 #FFFF00, stop:0.55 #FFFF00, stop:0.56 transparent);
	border-color: #FFFF00;
}
QStatusBar {
	color: #FF00BF;
}
QSpinBox, QDoubleSpinBox {
	background-color: #383838;
	border-color: #FF00BF;
	border-radius: 8px;
	border-style: ridge;
	border-width: 2px;
	color: #E6E6E6;
	font-size: 13px;
	padding: 2px;
	selection-background-color: #FF00BF;
	selection-color: #FFFFFF;
}
QSpinBox:hover, QDoubleSpinBox:hover {
	border-color: #00FF40;
}
QDoubleSpinBox::up-button, QSpinBox::up-button {
	background-color: #383838;
	border-bottom: none;
	border-color: #FF00BF;
	border-style: outset;
	border-top-right-radius: 6px;
	border-width: 1px;
	height: 10px;
	width: 10px;
}
QDoubleSpinBox::down-button, QSpinBox::down-button {
	background-color: #383838;
	border-color: #FF00BF;
	border-style: outset;
	border-top: none;
	border-bottom-right-radius: 6px;
	border-width: 1px;
	height: 10px;
	width: 10px;
}
QDoubleSpinBox::up-button:pressed, QDoubleSpinBox::down-button:pressed, QSpinBox::up-button:pressed, QSpinBox::down-button:pressed {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0.17 #FF3300, stop:0.34 #FFBF00, stop:0.51 #FFFF00, stop:0.68 #00FF40, stop:0.85 #0080FF, stop:1 #FF00BF);
}
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover, QSpinBox::up-button:hover, QSpinBox::down-button:hover {
	border-color: #FFBF00;
	border-style: inset;
	border-width: 1px;
	padding-top: -1px;
}
QTimeEdit, QDateTimeEdit, QDateEdit, QToolBox, QToolBox::tab, QToolBox::tab:selected, QScrollArea {
	background-color: #383838;
	color: #E6E6E6;	
}
QComboBox {
	background-color: #383838;
	border-color: #FF00BF;
	border-radius: 11px;
	border-style: groove;
	border-width: 2px;
	font-size: 11px;
	height: 20px;
	padding-bottom: 3px;
	padding-left: 4px;
	padding-right: 2px;
	padding-top: 3px;
	selection-color: #FFFFFF;
	selection-background-color: #FF00BF;
}
QComboBox::hover {
	border-color: #00FF40;
}
QComboBox:disabled {
	background-color: transparent;
	border-color: #0080FF;
	border-radius: 11px;
	border-style: groove;
	border-width: 2px;
	color: #0080FF;
}
QComboBox::drop-down {
	background-color: #383838;
	border-bottom-right-radius: 7px;
	border-color: #FF00BF;
	border-style: outset;
	border-top-right-radius: 7px;
	border-width: 1px;
	min-height: 10px;
	width: 10px;
}
QComboBox::drop-down:hover {
	border-color: #00FF40;
	border-style: inset;
	border-width: 1px;
	padding-top: -1px;
}
QComboBox::drop-down:disabled
{
	background-color: transparent;
	border: none;
}
QHeaderView::section {
	background-color: #383838;
	border-color: #FF00BF;
	border-radius: 11px;
	border-style: groove;
	border-width: 2px;
	font-size: 12px;
}
QHeaderView::section:hover {
	border-color: #00FF40;
}
QHeaderView::section:pressed {
	background-color: #FFBF00;
	color: #E6E6E6;
}
QHeaderView::up-arrow, QHeaderView::down-arrow {
	image: none;
}
QAbstractItemView {
	border-color: #FF00BF;
	border: none;
	selection-background-color: #FF00BF;
	selection-color: #FFFFFF;
}
QAbstractItemView::item {
	border-color: #383838;
	border-radius: 1px;
	border-style: groove;
	border-width: 2px;	
}
QAbstractItemView::item:focus {
	color: #FF00BF;
}
QAbstractItemView::item:focus:hover {
	color: #FF3300;
}
QAbstractItemView::item:hover {
	border-color: #00FF40;
}
QAbstractItemView QComboBox {
	background-color: #383838;
}
QAbstractItemView::indicator {
	background-color: #FFFFFF;
	border-color: #FF3300;
	border-radius: 7px;
	border-style: ridge;
	border-width: 2px;
	height: 10px;
	width: 10px;
}
QAbstractItemView::indicator:unchecked:hover {
	background-color: #00FF40;
	color: #00FF40;
}
QAbstractItemView::indicator:checked {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0.17 #FF3300, stop:0.34 #FFBF00, stop:0.51 #FFFF00, stop:0.68 #00FF40, stop:0.85 #0080FF, stop:1 #FF00BF);
	border-color: #FF00BF;
}
QAbstractItemView::indicator:checked:hover {
	background-color: #FF3300;
	color: #FF3300;
}
QColorDialog QPushButton {
	background-color: #FF00BF;
	color: #FFFFFF;
}
QColorDialog QPushButton:hover {
	background-color: #00FF40;
	color: #E6E6E6;
}
QColorDialog QPushButton:pressed {
	background-color: #FFBF00;
	color: #FFFFFF;
}
QScrollBar {
	background-color: #383838;
	border-color: #FF00BF;
	border-radius: 3px;
	border-style: ridge;
	border-width: 2px;
	width: 16px;
}
QScrollBar:hover {
	border-color: #00FF40;
}
QScrollBar::handle {
	border-color: #FF00BF;
	border-radius: 3px;
	border-style: outset;
	border-width: 2px;
}
QScrollBar::handle:hover {
	background-color: #FF00BF;
}
QScrollBar::handle:pressed {
	border-style: inset;
	background-color: #FFBF00;
}
QScrollBar::groove {
	background-color: transparent;
}
QScrollBar:sub-line, QScrollBar:add-line {
	background-color: #FF00BF;
	border-color: #FF00BF;
	border-radius: 3px;
	border-style: outset;
	border-width: 2px;
}
QScrollBar:sub-line:hover, QScrollBar:add-line:hover {
	background-color: #FF00BF;
}
QScrollBar:sub-line:pressed, QScrollBar:add-line:pressed {
	background-color: #FFBF00;
}
QScrollBar::add-page, QScrollBar::sub-page {
	background: none;
}
QScrollBar::add-page:pressed, QScrollBar::sub-page:pressed {
	border-color: #FFBF00;
	border-radius: 3px;
	border-style: inset;
	border-width: 2px;
}
QScrollBar::handle:vertical {
	margin-bottom: 17px;
	margin-top: 17px;
}
QScrollBar::handle:horizontal {
	margin-left: 17px;
	margin-right: 17px;
}
QSlider::groove:horizontal {
	height: 5px;
	background-color: #383838;
}
QSlider::groove:vertical {
	width: 5px;
	background-color: #383838;
}
QSlider::handle:horizontal {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0.17 #FF3300, stop:0.34 #FFBF00, stop:0.51 #FFFF00, stop:0.68 #00FF40, stop:0.85 #0080FF, stop:1 #FF00BF);
	border-color: #FF00BF;
	border-radius: 5px;
	border-style: ridge;
	border-width: 2px;
	margin: -3px 0;
	width: 7px;
}
QSlider::handle:vertical {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0.17 #FF3300, stop:0.34 #FFBF00, stop:0.51 #FFFF00, stop:0.68 #00FF40, stop:0.85 #0080FF, stop:1 #FF00BF);
	border-color: #FF00BF;
	border-radius: 5px;
	border-style: ridge;
	border-width: 2px;
	height: 7px;
	margin: 0 -3px;
}
QSlider::handle:vertical:hover, QSlider::handle:horizontal:hover{
	background-color: #00FF40;
}
QSlider::handle:vertical:pressed, QSlider::handle:horizontal:pressed {
	background-color: #FFBF00;
}
QSlider::add-page:horizontal:disabled, QSlider::sub-page:vertical:disabled {
	background-color: #0080FF;
}
QSlider::add-page:horizontal, QSlider::sub-page:vertical {
	background-color: #FFFFFF;
}
QSlider::sub-page:horizontal {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0.17 #FF3300, stop:0.34 #FFBF00, stop:0.51 #FFFF00, stop:0.68 #00FF40, stop:0.85 #0080FF, stop:1 #FF00BF);
}
QSlider::add-page:vertical {
	background-color: qlineargradient(spread:pad, x1:0, y1:1, x2:0, y2:0, stop:0.17 #FF3300, stop:0.34 #FFBF00, stop:0.51 #FFFF00, stop:0.68 #00FF40, stop:0.85 #0080FF, stop:1 #FF00BF);
}
QSlider::handle:horizontal:disabled, QSlider::groove:horizontal:disabled, QSlider::handle:vertical:disabled, QSlider::groove:vertical:disabled {
	background-color: qlineargradient(x1:1, y1:1, x2:0, y2:0, stop:0.44 #383838, stop:0.45 #FFFF00, stop:0.55 #FFFF00, stop:0.56 #383838);
	border-color: #FFFF00;
}