}
QRadioButton::indicator:unchecked {
	background-color: #FFFFFF;
	border-color: #CD69FF;
	border-radius: 5px;
	border-style: solid;
	border-width: 1px;
	height: 10px;
	width: 10px;
}
QRadioButton::indicator:unchecked:hover {
	background-color: #CD69FF;
