{
  "schemaVersion": 1,
  "id": "org.rayloom.parameter-pulse",
  "name": "Пульс · параметры эффекта",
  "version": "1.0.0",
  "author": "Rayloom",
  "license": "GPL-2.0-or-later",
  "effects": [{
    "id": "pulse",
    "name": "Цветной пульс",
    "description": "Пример настроек, объявленных автором: цвет, частота и мягкость пульса.",
    "parameters": [
      {"key":"tint","type":"color","label":"Цвет свечения","default":16108659},
      {"key":"frequency","type":"number","label":"Частота пульса","min":0.1,"max":4,"step":0.1,"default":1,"help":"Чем больше значение, тем чаще вспышки"},
      {"key":"floor","type":"select","label":"Свет между вспышками","default":0.25,"options":[{"value":0,"label":"Полностью гасить"},{"value":0.25,"label":"Мягкое свечение"},{"value":0.6,"label":"Яркое свечение"}]}
    ],
    "rgb": [
      {"op":"mul","args":[{"param":"tint","channel":"r"},{"op":"max","args":[{"param":"floor"},{"op":"abs","args":[{"op":"sin","args":[{"op":"mul","args":[{"var":"t"},{"param":"frequency"}]}]}]}]}]},
      {"op":"mul","args":[{"param":"tint","channel":"g"},{"op":"max","args":[{"param":"floor"},{"op":"abs","args":[{"op":"sin","args":[{"op":"mul","args":[{"var":"t"},{"param":"frequency"}]}]}]}]}]},
      {"op":"mul","args":[{"param":"tint","channel":"b"},{"op":"max","args":[{"param":"floor"},{"op":"abs","args":[{"op":"sin","args":[{"op":"mul","args":[{"var":"t"},{"param":"frequency"}]}]}]}]}]}
    ]
  }]
}
