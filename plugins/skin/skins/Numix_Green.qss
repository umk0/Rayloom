QWidget {
	background-color: transparent;
	color: #F2F2F2;
	font: normal;
}
QAbstractScrollArea,QDeclarativeView {
	background-color: #1E1E1E;
}
QGraphicsView {
	background-color: #999999;
}
QMainWindow {
	background-color: #1E1E1E;
}
QDialog {
	background-color: #1E1E1E;
}
QColorDialog {
	background-color: #1E1E1E;
}
QTextEdit {
	background-color: #1E1E1E;
	color: #F2F2F2;
}
QPlainTextEdit {
	selection-background-color: #00802B;
	background-color: #F2F2F2;
	border-style: solid;
	border-width: 1px;
	border-radius: 3px;
	padding: 1px;
	font-size: 11px;
	color: #1E1E1E;
}
QToolButton {
	border-style: solid;
	border-width: 1px;	
	border-radius: 3px;
	border-color: #4D4D4D;
	padding: 3px;
	background-color: #1E1E1E;
	font-size: 11px;
}
QToolButton:hover {
	border-color: #00B33C;
}
QToolButton:checked {
	background-color: #00B33C;
}
QToolButton:disabled {
	border-style: solid;
	border-width: 1px;	
	border-radius: 3px;
	border-color: #1E1E1E;
	color: #4D4D4D;		
	background-color: #1E1E1E;
}
QToolButton::menu-indicator {
	background: none;
}
QPushButton {
	border-style: solid;
	border-width: 1px;
	border-color: #4D4D4D;
	border-radius: 3px;
	padding: 4px;
	font-size: 10px;
	color: #F2F2F2;
	background-color: #1E1E1E;
	min-width: 50px;
	height: 18px;
	font-size: 11px;
}
QPushButton:hover {
	border-color: #00B33C;
}
QPushButton:pressed {
	border-color: #00B33C;
	background-color: #4D4D4D;
}
QPushButton:disabled {
	border-style: solid;
	border-width: 1px;	
	border-radius: 3px;
	border-color: #1E1E1E;
	color: #4D4D4D;
	background-color: #1E1E1E;
}
QLineEdit {
	border-width: 1px;
	border-radius: 3px;
	border-color: #4D4D4D;
	border-style: inset;
	padding-left: 2px;
	padding-bottom: 2px;
	color: #F2F2F2;
	background-color: #1E1E1E;
	selection-background-color: #00802B;
	selection-color: #F2F2F2;
	font-size: 11px;
	min-height: 18px;
}
QLineEdit:hover {
	border-radius: 3px;
	border-style: solid;
	border-width: 1px;
	border-color: #00B33C;
}
QLabel {
	color: #F2F2F2;
}
QLCDNumber {
	color: #00B33C;
}
QProgressBar {
	text-align: center;
	color: #F2F2F2;
	border-width: 1px;
	border-radius: 3px;
	border-color: #00B33C;
	border-style: inset;
	background-color: #1E1E1E;
	font-size: 11px;
	height: 26px;
}
QProgressBar::chunk {
	background-color: #00B33C;
	border-radius: 2px;
}
QMenuBar {
	background-color: #1E1E1E;
}
QMenuBar::item {
	color: #F2F2F2;
  	spacing: 3px;
  	padding: 1px 4px;
  	background-color: #1E1E1E;
}
QMenu {
	background-color: #1E1E1E;
	padding: 0px;
	font-size: 11px;
}
QMenuBar::item:selected {
  	background-color: #1E1E1E;
	color: #00B33C;
}
QMenu::item {
	border: none;
	padding: 1px;
	color: #F2F2F2;
	padding-left: 15px;
	padding-top: 4px;
	padding-bottom: 4px;
	padding-right: 15px;
	background-color: #1E1E1E;
	min-width: 80px;
	font-size: 11px;
}
QMenu::item:selected {
	border-style: solid;
	border-color: #00B33C;
	border-width: 1px;
	border-radius: 3px;
	color: #F2F2F2;
	padding-left: 13px;
}
QTabWidget {
	color: #F2F2F2;
	background-color: #1E1E1E;
}
QTabWidget::pane {
	border-color: #4D4D4D;
	background-color: #1E1E1E;
	border-style: solid;
	border-width: 1px;
	border-radius: 3px;
	padding-top: -1px;
}
QTabBar::tab {
	border-style: solid;
	border-radius: 3px;
	border-color: #1E1E1E;
	color: #4D4D4D;
	padding-right: 6px;
	padding-left: 6px;
	padding-bottom: 3px;
	padding-top: 3px;
	background-color: #1E1E1E;
	min-height: 20px;
	min-width: 80px;
	margin: 1px;
}
QTabBar::tab:selected, QTabBar::tab:last:selected, QTabBar::tab:hover {
	border-style: solid;
	border-radius: 3px;
	border-color: #00B33C;
	border-width: 1px;
	color: #F2F2F2;
	padding-top: 1px;
}
QCheckBox {
	color: #F2F2F2;
	border-radius: 3px;
	padding: 3px;
	background-color: #1E1E1E;
	border-width: 1px;
	min-height: 18px;
}
QCheckBox:disabled {	
	border-style: solid;
	border-width: 1px;	
	border-radius: 3px;
	border-color: #1E1E1E;
	color: #4D4D4D;
	background-color: #1E1E1E;
	padding-left: 2px;
}
QCheckBox:hover {
	border-radius: 3px;
	border-style: solid;
	padding: 2px;
	border-width: 1px;
	border-color: #00B33C;
	background-color: #1E1E1E;
}
QCheckBox::indicator:checked {
	height: 10px;
	width: 10px;
	border-radius: 3px;
	border-style: solid;
	border-width: 1px;
	border-color: #00B33C;
	color: #F2F2F2;
	background-color: #00B33C;
}
QCheckBox::indicator:unchecked {
	height: 10px;
	width: 10px;
	border-radius: 3px;
	border-style: solid;
	border-width: 1px;
	border-color: #4D4D4D;
	color: #F2F2F2;
}
QCheckBox::indicator:unchecked:hover {
	border-color: #00B33C;
}
QCheckBox::indicator:checked:hover {
	border-color: #4D4D4D;
}
QCheckBox::indicator:disabled {
	background-color: qlineargradient(x1:1, y1:1, x2:0, y2:0, stop:0.44 #1E1E1E, stop:0.45 #4D4D4D, stop:0.55 #4D4D4D, stop:0.56 #1E1E1E);
}
QRadioButton {
	color: #F2F2F2;
	background-color: #1E1E1E;
	padding: 2px;
	border-radius: 3px;
	font-size: 11px;
}
QRadioButton::indicator:unchecked:hover {
	border-color: #00B33C;
}
QRadioButton::indicator:checked:hover {
	border-color: #4D4D4D;
}
QRadioButton::indicator:checked {
	height: 10px;
	width: 10px;
	border-style: solid;
	border-radius: 3px;
	border-width: 1px;
	border-color: #00B33C;
	background-color: #00B33C;
}
QRadioButton::indicator:!checked {
	height: 10px;
	width: 10px;
	border-style: solid;
	border-radius: 3px;
	border-width: 1px;
	border-color: #4D4D4D;
	background-color: transparent;
}
QRadioButton:disabled {
	border: none;
	color: #4D4D4D;
	background-color: #1E1E1E;
}
QRadioButton::indicator:disabled {
	background-color: qlineargradient(x1:1, y1:1, x2:0, y2:0, stop:0.44 #1E1E1E, stop:0.45 #4D4D4D, stop:0.55 #4D4D4D, stop:0.56 #1E1E1E);
}
QStatusBar {
	color: #00B33C;
}
QSpinBox, QDoubleSpinBox {
	border: solid;
	color: #F2F2F2;
	selection-background-color: #00802B;
	selection-color: #F2F2F2;
	background-color: #1E1E1E;
	border-style: solid;
	border-width: 1px;
	border-color: #4D4D4D;
	font-size: 13px;
	padding: 2px;
	border-bottom-left-radius: 3px;
	border-top-left-radius: 3px;
}
QSpinBox:hover, QDoubleSpinBox:hover {
	border-style: solid;
	border-width: 1px;
	border-color: #00B33C;
}
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button, QSpinBox::up-button, QSpinBox::down-button {
	border-style: solid;
	border-width: 1px;
	border-color: #1E1E1E;
	background-color: #4D4D4D;
	min-height: 10px;
}
QDoubleSpinBox::up-button:pressed, QDoubleSpinBox::down-button:pressed, QSpinBox::up-button:pressed, QSpinBox::down-button:pressed {
	background-color: #00B33C;
}
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover, QSpinBox::up-button:hover, QSpinBox::down-button:hover {
	border-color: #00802B;
}
QTimeEdit, QDateTimeEdit, QDateEdit, QToolBox, QToolBox::tab, QToolBox::tab:selected, QScrollArea {
	color: #F2F2F2;	
	background-color: #1E1E1E;
}
QSlider::groove:horizontal {
	height: 5px;
	background-color: #00B33C;
}
QSlider::groove:vertical {
	width: 5px;
	background-color: #00B33C;
}
QSlider::handle:horizontal {
	background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #00B33C, stop:1 #F2F2F2);
	border: 1px solid #1E1E1E;
	width: 14px;
	margin: -5px 0;
	border-radius: 7px;
}
QSlider::handle:vertical {
	background-color: qlineargradient(x1:1, y1:1, x2:0, y2:0, stop:0 #00B33C, stop:1 #F2F2F2);
	border: 1px solid #1E1E1E;
	height: 14px;
	margin: 0 -5px;
	border-radius: 7px;
}
QSlider::add-page:horizontal, QSlider::sub-page:vertical {
	background-color: #F2F2F2;
}
QSlider::sub-page:horizontal, QSlider::add-page:vertical, QSlider::handle:horizontal:pressed, QSlider::groove:horizontal:pressed, QSlider::handle:vertical:pressed, QSlider::groove:vertical:pressed  {
	background-color: #00B33C;
}
QSlider::handle:horizontal:hover, QSlider::groove:horizontal:hover, QSlider::handle:vertical:hover, QSlider::groove:vertical:hover {
	border-color: #00802B;
}
QSlider::handle:horizontal:disabled, QSlider::groove:horizontal:disabled, QSlider::handle:vertical:disabled, QSlider::groove:vertical:disabled {
	background-color: #4D4D4D;
}
QComboBox {
	border-style: solid;
	border-radius: 3px;
	border-width: 1px;
	border-color: #4D4D4D;
	padding-left: 4px;
	padding-top: 3px;
	padding-bottom: 3px;
	padding-right: 2px;
	selection-color: #F2F2F2;
	selection-background-color: #00802B;
	height: 20px;
	font-size: 11px;
}
QComboBox::hover {
	border-color: #00B33C;
}
QComboBox::editable {
	background-color: #1E1E1E;
	border-style: solid;
	border-radius: 3px;
	border-width: 1px;
	border-color: #4D4D4D;
}
QComboBox:disabled {
	border-style: solid;
	border-width: 1px;	
	border-radius: 3px;
	border-color: #1E1E1E;
}
QComboBox:on {
	padding-top: 3px;
	padding-left: 4px;
}
QComboBox::drop-down:disabled
{
	border: none;
}
QAbstractItemView {
	border-style: solid;
	border-width: 1px;	
	border-radius: 3px;
	border-color: #1E1E1E;
	selection-background-color: #00B33C;
	selection-color: #1E1E1E;
}
QAbstractItemView::item {
	border-style: solid;
	border-width: 1px;	
	border-radius: 3px;
	border-color: #1E1E1E;
}
QAbstractItemView::item:focus {
	color: #00B33C;
}
QAbstractItemView::item:focus:hover {
	color: #F2F2F2;
}
QAbstractItemView::item:hover {
	border-color: #00B33C;
}
QAbstractItemView QComboBox {
	background-color: #1E1E1E;
}
QAbstractItemView::indicator {
	border-style: solid;
	border-width: 1px;	
	border-radius: 3px;
	border-color: #4D4D4D;
	background-color: #1E1E1E;
}
QAbstractItemView::indicator:!checked:hover {
	border-style: solid;
	border-color: #00B33C;
	background-color: #1E1E1E;
}
QAbstractItemView::indicator:checked {
	background-color: #00B33C;
	border-color: #00B33C;
}
QAbstractItemView::indicator:checked:hover {
	border-color: #4D4D4D;
}
QHeaderView::section {
	background-color: #1E1E1E;
	border-style: solid;
	border-width: 1px;
	border-color: #4D4D4D;
	font-size: 12px;
}
QHeaderView::section:hover {
	background-color: #1E1E1E;
	border-radius: 3px;
	border-color: #00B33C;
}
QHeaderView::section:pressed {
	background-color: #00B33C;
	border-radius: 3px;
	border-color: #00B33C;
}
QHeaderView::up-arrow, QHeaderView::down-arrow {
	image: none;
}
QColorDialog QPushButton {
	background-color: #4D4D4D;
}
QColorDialog QPushButton:hover {
	background-color: #00802B;
}
QColorDialog QPushButton:pressed {
	background-color: #00B33C;
}
QScrollBar {
	background-color: #1E1E1E;
	width: 16px;
	border-style: solid;
	border-width: 1px;
	border-color: #4D4D4D;
	border-radius: 3px;
}
QScrollBar:hover {
	border-color: #1E1E1E;
}
QScrollBar::handle {
	border-style: solid;
	border-width: 1px;
	border-color: #00802B;
	border-radius: 3px;
}
QScrollBar::handle:hover {
	background-color: #00802B;
}
QScrollBar::handle:pressed {
	background-color: #00B33C;
}
QScrollBar::groove {
	background-color: #00B33C;
}
QScrollBar:sub-line, QScrollBar:add-line {
	border-style: solid;
	border-width: 1px;
	border-color: #4D4D4D;
	border-radius: 3px;
	background-color: #4D4D4D;
}
QScrollBar:sub-line:hover, QScrollBar:add-line:hover {
	background-color: #00802B;
}
QScrollBar:sub-line:pressed, QScrollBar:add-line:pressed {
	background-color: #00B33C;
}
QScrollBar::add-page, QScrollBar::sub-page {
	background: none;
}
QScrollBar::add-page:pressed, QScrollBar::sub-page:pressed {
	border-style: solid;
	border-width: 1px;
	border-color: #00B33C;
	border-radius: 3px;
}
QScrollBar::handle:vertical {
	margin-top: 17px;
	margin-bottom: 17px;
}
QScrollBar::handle:horizontal {
	margin-left: 17px;
	margin-right: 17px;
}